# Copy to .env (local, git-ignored). Never commit real values.

# --- Frontend (public, bundled into the site) ---
# Lemon Squeezy hosted checkout links. Use TEST MODE links until launch.
VITE_CHECKOUT_URL_MONTHLY=
VITE_CHECKOUT_URL_YEARLY=
VITE_CHECKOUT_URL_LIFETIME=
VITE_SUPPORT_EMAIL=
# Cloudflare Web Analytics beacon token (cookieless). Leave empty to disable.
VITE_ANALYTICS_TOKEN=

# --- Cloudflare Pages Functions (server-side; set in Pages > Settings > Variables, or .dev.vars locally) ---
# The store and product a license key must belong to. Not secret, but keep them out of code.
LS_STORE_ID=
LS_PRODUCT_ID=
